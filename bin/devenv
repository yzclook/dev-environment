#!/usr/bin/env bash

# ================================================
# DevEnv - 跨平台开发环境一键部署系统
# 版本: 1.0.0
# 作者: DevEnv Team
# 许可证: MIT
# ================================================

set -euo pipefail

# 脚本根目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC_DIR="$SCRIPT_DIR/src"

# 加载核心模块
source "$SRC_DIR/core/logger.sh"
source "$SRC_DIR/core/utils.sh"
source "$SRC_DIR/core/config.sh"
source "$SRC_DIR/core/validator.sh"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 显示版本
show_version() {
    cat << EOF
DevEnv v1.0.0
跨平台开发环境一键部署系统
EOF
}

# 显示帮助
show_help() {
    cat << EOF
用法: devenv [命令] [选项] [参数]

命令:
  init          初始化 DevEnv
  install       安装组件
  update        更新 DevEnv
  config        配置管理
  doctor        系统诊断
  info          系统信息
  start         启动服务
  stop          停止服务
  restart       重启服务
  status        服务状态
  logs          查看日志
  backup        备份数据
  restore       恢复数据
  uninstall     卸载 DevEnv
  version       显示版本
  help          显示帮助

组件:
  git           Git 工具
  maven         Maven
  conda         Conda
  docker        Docker
  java          Java
  node          Node.js
  python        Python
  go            Go
  rust          Rust
  mysql         MySQL
  redis         Redis
  mongodb       MongoDB
  kafka         Kafka
  consul        Consul
  prometheus    Prometheus
  grafana       Grafana
  elasticsearch Elasticsearch
  kibana        Kibana

选项:
  -h, --help     显示帮助
  -v, --version  显示版本
  -d, --debug    调试模式
  -q, --quiet    安静模式
  --force        强制操作
  --dry-run      试运行
  --platform     指定平台
  --profile      使用配置文件

示例:
  devenv init                    初始化 DevEnv
  devenv install git maven      安装 Git 和 Maven
  devenv install --all          安装所有组件
  devenv config show            显示配置
  devenv doctor                 系统诊断
  devenv start mysql redis      启动 MySQL 和 Redis
  devenv status                 查看服务状态

更多信息请查看: https://github.com/devenv/devenv
EOF
}

# 主函数
main() {
    local command="${1:-}"
    local subcommand="${2:-}"

    # 处理全局选项
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -d|--debug)
            export DEVENV_DEBUG=1
            shift
            command="${1:-}"
            subcommand="${2:-}"
            ;;
        -q|--quiet)
            export DEVENV_QUIET=1
            shift
            command="${1:-}"
            subcommand="${2:-}"
            ;;
    esac

    # 如果没有命令，显示帮助
    if [ -z "$command" ]; then
        show_help
        exit 0
    fi

    # 执行命令
    case "$command" in
        init)
            source "$SRC_DIR/commands/init.sh"
            devenv_init "${@:2}"
            ;;
        install)
            source "$SRC_DIR/commands/install.sh"
            devenv_install "${@:2}"
            ;;
        update)
            source "$SRC_DIR/commands/update.sh"
            devenv_update "${@:2}"
            ;;
        config)
            source "$SRC_DIR/commands/config.sh"
            devenv_config "${@:2}"
            ;;
        doctor)
            source "$SRC_DIR/commands/doctor.sh"
            devenv_doctor "${@:2}"
            ;;
        info)
            source "$SRC_DIR/commands/info.sh"
            devenv_info "${@:2}"
            ;;
        start)
            source "$SRC_DIR/commands/start.sh"
            devenv_start "${@:2}"
            ;;
        stop)
            source "$SRC_DIR/commands/stop.sh"
            devenv_stop "${@:2}"
            ;;
        restart)
            source "$SRC_DIR/commands/restart.sh"
            devenv_restart "${@:2}"
            ;;
        status)
            source "$SRC_DIR/commands/status.sh"
            devenv_status "${@:2}"
            ;;
        logs)
            source "$SRC_DIR/commands/logs.sh"
            devenv_logs "${@:2}"
            ;;
        backup)
            source "$SRC_DIR/commands/backup.sh"
            devenv_backup "${@:2}"
            ;;
        restore)
            source "$SRC_DIR/commands/restore.sh"
            devenv_restore "${@:2}"
            ;;
        uninstall)
            source "$SRC_DIR/commands/uninstall.sh"
            devenv_uninstall "${@:2}"
            ;;
        version)
            show_version
            ;;
        help)
            show_help
            ;;
        *)
            log_error "未知命令: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# 捕获退出信号
trap 'cleanup' EXIT INT TERM

# 清理函数
cleanup() {
    log_debug "清理资源..."
}

# 执行主函数
main "$@"